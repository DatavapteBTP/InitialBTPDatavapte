<mvc:View
  controllerName="datavapte.migration.studio.controller.Viewer"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout">
  <Page id="viewerPage" title="{app>/current/objectName}" showNavButton="true" navButtonPress=".onNavBack">
    <customHeader>
      <Bar class="dmsHeader">
        <contentLeft>
          <Button icon="sap-icon://nav-back" tooltip="{i18n>back}" press=".onNavBack" />
          <Title text="{app>/current/objectName}" />
        </contentLeft>
        <contentMiddle>
          <Text text="{app>/current/fileName}" />
        </contentMiddle>
        <contentRight>
          <ObjectStatus
            class="sapUiTinyMarginEnd"
            text="{app>/current/sheetCount} tabs · {app>/current/fieldCount} fields · {app>/current/rowCount} rows"
            state="Information" />
        </contentRight>
      </Bar>
    </customHeader>
    <content>
      <VBox height="100%" class="dmsWorkbook">
        <MessageStrip
          text="{app>/current/parseMessage}"
          type="Information"
          showIcon="true"
          class="sapUiSmallMargin" />
        <HBox id="sheetHost" height="100%" width="100%" renderType="Bare" class="dmsSheetHost">
          <VBox id="gridPane" width="100%" height="100%" class="dmsGridPane">
            <HBox id="columnMeta" class="dmsColumnMeta sapUiSmallMarginBeginEnd" visible="false" />
            <ScrollContainer
              id="gridScroll"
              horizontal="true"
              vertical="true"
              width="100%"
              height="100%"
              class="dmsGridScroll">
              <core:HTML id="excelGrid" preferDOM="true" sanitizeContent="false" />
            </ScrollContainer>
          </VBox>
        </HBox>
      </VBox>
    </content>
    <footer>
      <Bar class="dmsSheetTabs">
        <contentLeft>
          <HBox id="sheetTabs" alignItems="Center" class="dmsTabStrip" />
        </contentLeft>
      </Bar>
    </footer>
  </Page>
</mvc:View>
