<mvc:View
  controllerName="datavapte.migration.studio.controller.Viewer"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:table="sap.ui.table">
  <Page id="viewerPage" title="{app>/current/objectName}" showNavButton="true" navButtonPress=".onNavBack">
    <customHeader>
      <Bar class="dmsHeader">
        <contentLeft>
          <Button icon="sap-icon://nav-back" tooltip="{i18n>back}" press=".onNavBack" />
          <Title text="{app>/current/objectName}" />
        </contentLeft>
        <contentMiddle>
          <Text text="{app>/current/fileName}" />
        </contentMiddle>
        <contentRight>
          <ObjectStatus
            class="sapUiTinyMarginEnd"
            text="{app>/current/sheetCount} tabs · {app>/current/fieldCount} fields · {app>/current/rowCount} rows"
            state="Information" />
        </contentRight>
      </Bar>
    </customHeader>
    <content>
      <VBox height="100%" class="dmsWorkbook">
        <MessageStrip
          text="{app>/current/parseMessage}"
          type="Information"
          showIcon="true"
          class="sapUiSmallMargin" />
        <IconTabBar
          id="sheetTabBar"
          select=".onSheetSelect"
          expandable="false"
          stretchContentHeight="true"
          headerMode="Inline"
          class="dmsIconTabBar sapUiResponsiveContentPadding">
          <items />
          <content>
            <VBox height="100%" class="dmsEditorPane">
              <OverflowToolbar>
                <Title id="sheetTitle" text="{app>/editor/title}" />
                <ObjectStatus
                  id="sheetBadge"
                  text="{i18n>mandatorySheet}"
                  state="Warning"
                  visible="{app>/editor/isMandatory}" />
                <ToolbarSpacer />
                <Button
                  id="addRowButton"
                  text="{i18n>addRow}"
                  icon="sap-icon://add"
                  visible="{app>/editor/tableVisible}"
                  press=".onAddRow" />
                <Button
                  id="deleteRowButton"
                  text="{i18n>deleteRow}"
                  icon="sap-icon://delete"
                  visible="{app>/editor/tableVisible}"
                  press=".onDeleteRow" />
                <Button
                  id="saveButton"
                  text="{i18n>saveSheet}"
                  type="Emphasized"
                  icon="sap-icon://save"
                  enabled="{app>/editor/dirty}"
                  press=".onSaveSheet" />
              </OverflowToolbar>
              <TextArea
                id="introEditor"
                value="{app>/editor/introText}"
                visible="{app>/editor/introVisible}"
                liveChange=".onIntroChange"
                growing="true"
                growingMaxLines="24"
                width="100%"
                rows="16"
                class="sapUiSmallMarginTop" />
              <table:Table
                id="sheetTable"
                visible="{app>/editor/tableVisible}"
                rows="{app>/editor/rows}"
                selectionMode="Single"
                selectionBehavior="Row"
                editable="true"
                visibleRowCountMode="Auto"
                minAutoRowCount="8"
                columnHeaderHeight="92"
                rowHeight="36"
                enableColumnReordering="false"
                ariaLabelledBy="sheetTitle"
                class="dmsEditableTable sapUiSmallMarginTop" />
            </VBox>
          </content>
        </IconTabBar>
      </VBox>
    </content>
  </Page>
</mvc:View>
