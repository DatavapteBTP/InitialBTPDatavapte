{
  "name": "datavapte-migration-studio",
  "version": "1.0.0",
  "description": "SAP BTP CAP application that uploads SAP Data Migration Cockpit Excel templates and renders each sheet as a matching UI5 screen.",
  "repository": "https://github.com/DatavapteBTP/InitialBTPDatavapte",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/sqlite": "^1.11.1",
    "@sap/cds": "^8.9.4",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.2.5",
    "xlsx": "^0.18.5",
    "@sap-cloud-sdk/connectivity": "^3.9.0",
    "@sap-cloud-sdk/core": "^1.47.1",
    "@sap-cloud-sdk/http-client": "^3.16.0",
    "@sap-cloud-sdk/mail-client": "^3.9.0",
    "@sap/cds-hana": "^2",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "@sap/hana-client": "^2.20.22",
    "@sap/textbundle": "^5.0.0",
    "@sap/xsenv": "^3.3.1",
    "@sap/xssec": "^3.6.1",
    "api": "^6.1.1",
    "axios": "^0.21.4",
    "cfenv": "^1.2.4",
    "exceljs": "^4.4.0",
    "hdb": "^0.19.9",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "passport": "^0.7.0",
    "sap-cf-axios": "^0.4.8"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8.9.4",
    "@sap/edm-converters": "^1.0.43",
    "@sap/eslint-plugin-cds": "^3",
    "@sap/hdi-deploy": "4.9.4",
    "@sap/ux-specification": "^1.120.10",
    "eslint": "^9",
    "rimraf": "^3.0.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --port 4004",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "build": "cds build --production",
    "sample": "node scripts/generate-sample-template.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "[development]": {
        "auth": "dummy"
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  },
  "sapux": [
    "app/migration-studio"
  ]
}